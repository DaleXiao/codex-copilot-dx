{
  "name": "codex-copilot-dx",
  "version": "1.2.19",
  "description": "Local gateway for Codex and Claude with Copilot, Microsoft 365 and custom APIs",
  "author": "Dale Xiao",
  "type": "module",
  "bin": {
    "ccdx": "bin/cli.mjs",
    "codex-copilot-dx": "bin/codex-copilot-dx.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/benchmark.mjs",
    "scripts/benchmark-probes.mjs",
    "scripts/fixtures/",
    "README.md",
    "docs/REFERENCE.md",
    "docs/ARCHITECTURE.md"
  ],
  "keywords": [
    "codex",
    "copilot",
    "github",
    "openai",
    "proxy",
    "responses-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalexiao/codex-copilot-dx.git"
  },
  "homepage": "https://github.com/dalexiao/codex-copilot-dx#readme",
  "bugs": {
    "url": "https://github.com/dalexiao/codex-copilot-dx/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node scripts/offline-smoke.mjs && node scripts/sse-idle-replay.mjs",
    "test:package": "node scripts/package-lifecycle-smoke.mjs",
    "test:e2e": "bash test/e2e.sh",
    "bench": "node scripts/benchmark.mjs",
    "bench:payload": "node scripts/benchmark.mjs --large-payload",
    "bench:check": "node scripts/benchmark.mjs --check",
    "pack:check": "npm pack --dry-run --json",
    "verify": "npm test && npm run test:smoke && npm run bench:check && npm run pack:check",
    "prepublishOnly": "npm run verify",
    "release:pack": "node scripts/release-artifacts.mjs",
    "test:release-network": "node scripts/release-network-replay.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "smol-toml": "1.9.1"
  },
  "optionalDependencies": {
    "@azure/msal-node-runtime": "0.20.6"
  }
}
